+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Mvc;
+using Moq;
+using UserManagement.Application.Interfaces;
+using UserManagement.Core.DTOs;
+using UserManagement.Web.Controllers;
+
+namespace UserManagement.UnitTests.Controllers;
+
+public sealed class MobileAccountControllerTests
+{
+    [Theory]
+    [InlineData(DeleteAccountResult.Success, 204)]
+    [InlineData(DeleteAccountResult.InvalidPassword, 400)]
+    [InlineData(DeleteAccountResult.LastActiveAdmin, 409)]
+    public async Task DeleteAccount_MapsServiceResultWithoutCookies(DeleteAccountResult outcome, int status)
+    {
+        var service = new Mock<IAccountService>();
+        var current = new Mock<ICurrentUserService>();
+        current.SetupGet(value => value.UserId).Returns("owner-id");
+        service.Setup(value => value.DeleteAccountAsync("owner-id", "password123", It.IsAny<CancellationToken>())).ReturnsAsync(outcome);
+        var controller = new MobileAccountController(service.Object, current.Object)
+        {
+            ControllerContext = new ControllerContext { HttpContext = new DefaultHttpContext() }
+        };
+        var result = await controller.DeleteAccount(new DeleteAccountRequest { CurrentPassword = "password123" }, CancellationToken.None);
+        Assert.Equal(status, result is StatusCodeResult code ? code.StatusCode : ((ObjectResult)result).StatusCode);
+        Assert.Equal(0, controller.Response.Headers.SetCookie.Count);
+        service.Verify(value => value.DeleteAccountAsync("owner-id", "password123", It.IsAny<CancellationToken>()), Times.Once);
+    }
+
+    [Theory]
+    [InlineData(true, 204)]
+    [InlineData(false, 400)]
+    public async Task ChangePassword_DelegatesToExistingService(bool changed, int status)
+    {
+        var service = new Mock<IAccountService>();
+        var current = new Mock<ICurrentUserService>();
+        current.SetupGet(value => value.UserId).Returns("owner-id");
+        service.Setup(value => value.ChangePasswordAsync("owner-id", "current-password", "new-password", It.IsAny<CancellationToken>())).ReturnsAsync(changed);
+        var controller = new MobileAccountController(service.Object, current.Object)
+        {
+            ControllerContext = new ControllerContext { HttpContext = new DefaultHttpContext() }
+        };
+        var result = await controller.ChangePassword(new ChangePasswordRequest { CurrentPassword = "current-password", NewPassword = "new-password" }, CancellationToken.None);
+        Assert.Equal(status, result is StatusCodeResult code ? code.StatusCode : ((ObjectResult)result).StatusCode);
+        service.Verify(value => value.ChangePasswordAsync("owner-id", "current-password", "new-password", It.IsAny<CancellationToken>()), Times.Once);
+        Assert.Equal(0, controller.Response.Headers.SetCookie.Count);
+    }
+
+    [Fact]
+    public async Task MissingCurrentUser_DoesNotMutateAccount()
+    {
+        var service = new Mock<IAccountService>();
+        var controller = new MobileAccountController(service.Object, Mock.Of<ICurrentUserService>());
+        Assert.Equal(401, Assert.IsType<ObjectResult>(await controller.DeleteAccount(new DeleteAccountRequest(), CancellationToken.None)).StatusCode);
+        Assert.Equal(401, Assert.IsType<ObjectResult>(await controller.ChangePassword(new ChangePasswordRequest(), CancellationToken.None)).StatusCode);
+        service.VerifyNoOtherCalls();
+    }
