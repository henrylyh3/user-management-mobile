+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.RateLimiting;
+using UserManagement.Application.Interfaces;
+using UserManagement.Core.DTOs;
+
+namespace UserManagement.Web.Controllers;
+
+[ApiController]
+[Route("api/mobile/account")]
+[Authorize(AuthenticationSchemes = JwtBearerDefaults.AuthenticationScheme)]
+public sealed class MobileAccountController(IAccountService accountService, ICurrentUserService currentUser) : ControllerBase
+{
+    [HttpPost("change-password")]
+    public async Task<IActionResult> ChangePassword(ChangePasswordRequest request, CancellationToken cancellationToken)
+    {
+        if (string.IsNullOrWhiteSpace(currentUser.UserId)) return UnauthorizedProblem();
+        if (!await accountService.ChangePasswordAsync(currentUser.UserId, request.CurrentPassword, request.NewPassword, cancellationToken))
+        {
+            return Problem(statusCode: StatusCodes.Status400BadRequest, title: "Password not changed", detail: "The current password is incorrect or the new password matches it.");
+        }
+        return NoContent();
+    }
+
+    [HttpDelete]
+    [EnableRateLimiting("Auth")]
+    public async Task<IActionResult> DeleteAccount(DeleteAccountRequest request, CancellationToken cancellationToken)
+    {
+        if (string.IsNullOrWhiteSpace(currentUser.UserId)) return UnauthorizedProblem();
+        var result = await accountService.DeleteAccountAsync(currentUser.UserId, request.CurrentPassword, cancellationToken);
+        return result switch
+        {
+            DeleteAccountResult.Success => NoContent(),
+            DeleteAccountResult.InvalidPassword => Problem(statusCode: StatusCodes.Status400BadRequest, title: "Account not deleted", detail: "The current password is incorrect."),
+            DeleteAccountResult.LastActiveAdmin => Problem(statusCode: StatusCodes.Status409Conflict, title: "Account deletion rejected", detail: "The final active administrator cannot delete their account.", extensions: new Dictionary<string, object?> { ["code"] = "last_active_admin" }),
+            _ => throw new InvalidOperationException("Unknown account deletion result.")
+        };
+    }
+
+    private ObjectResult UnauthorizedProblem() => Problem(statusCode: StatusCodes.Status401Unauthorized, title: "Unauthenticated", detail: "Please sign in again.");
+}
