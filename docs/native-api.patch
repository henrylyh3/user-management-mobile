+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.RateLimiting;
+using UserManagement.Application.Interfaces;
+using UserManagement.Core.DTOs;
+
+namespace UserManagement.Web.Controllers;
+
+[ApiController]
+[Route("api/mobile/auth")]
+[Authorize(AuthenticationSchemes = JwtBearerDefaults.AuthenticationScheme)]
+[ResponseCache(NoStore = true, Location = ResponseCacheLocation.None)]
+public sealed class MobileAuthController(IAuthService authService, ICurrentUserService currentUser) : ControllerBase
+{
+    [AllowAnonymous]
+    [HttpPost("signin")]
+    [EnableRateLimiting("Auth")]
+    public async Task<IActionResult> Signin(SigninRequest request, CancellationToken cancellationToken)
+    {
+        var result = await authService.SigninAsync(request, CreateClientSessionInfo(), cancellationToken);
+        return result.Status switch
+        {
+            SigninStatus.Success => TokenResponse(result.Session ?? throw new InvalidOperationException("Successful sign-in did not create a session.")),
+            SigninStatus.InvalidCredentials => Problem(statusCode: StatusCodes.Status401Unauthorized, title: "Invalid credentials", detail: "Invalid email or password.", extensions: new Dictionary<string, object?> { ["code"] = "invalid_credentials", ["captchaRequired"] = result.CaptchaRequired }),
+            SigninStatus.CaptchaRequired => Problem(statusCode: StatusCodes.Status400BadRequest, title: "Human verification failed", detail: "Complete the human verification and try again.", extensions: new Dictionary<string, object?> { ["code"] = "captcha_required", ["captchaRequired"] = true }),
+            SigninStatus.EmailVerificationRequired => Problem(statusCode: StatusCodes.Status403Forbidden, title: "Email verification required", detail: "Verify your email before signing in."),
+            SigninStatus.LockedOut => Problem(statusCode: StatusCodes.Status429TooManyRequests, title: "Account temporarily locked", detail: "Too many failed sign-in attempts. Try again later."),
+            SigninStatus.AccountDisabled => Problem(statusCode: StatusCodes.Status403Forbidden, title: "Account unavailable", detail: "This account is unavailable. Contact an administrator.", extensions: new Dictionary<string, object?> { ["code"] = "account_disabled" }),
+            _ => throw new InvalidOperationException("Unknown sign-in result.")
+        };
+    }
+
+    [AllowAnonymous]
+    [HttpPost("refresh")]
+    [EnableRateLimiting("Auth")]
+    public async Task<IActionResult> Refresh(NativeRefreshTokenRequest request)
+    {
+        var session = await authService.RefreshAsync(request.RefreshToken, CreateClientSessionInfo());
+        return session is null
+            ? Problem(statusCode: StatusCodes.Status401Unauthorized, title: "Session expired", detail: "Please sign in again.")
+            : TokenResponse(session);
+    }
+
+    [AllowAnonymous]
+    [HttpPost("signout")]
+    public async Task<IActionResult> Signout(NativeRefreshTokenRequest request)
+    {
+        await authService.SignoutAsync(request.RefreshToken);
+        return NoContent();
+    }
+
+    [HttpPost("signout-all")]
+    public async Task<IActionResult> SignoutAll()
+    {
+        if (string.IsNullOrWhiteSpace(currentUser.UserId)) return UnauthorizedProblem();
+        await authService.SignoutAllAsync(currentUser.UserId);
+        return NoContent();
+    }
+
+    [HttpDelete("sessions/{sessionId}")]
+    public async Task<IActionResult> RevokeSession(string sessionId)
+    {
+        if (string.IsNullOrWhiteSpace(currentUser.UserId)) return UnauthorizedProblem();
+        if (!Guid.TryParseExact(sessionId, "N", out _))
+        {
+            return Problem(statusCode: StatusCodes.Status400BadRequest, title: "Invalid session", detail: "The session identifier is invalid.");
+        }
+
+        var result = await authService.RevokeSessionAsync(currentUser.UserId, sessionId, currentUser.SessionId);
+        return result.Revoked ? Ok(new { result.RevokedCurrentSession }) : NotFound();
+    }
+
+    private OkObjectResult TokenResponse(AuthSession session)
+    {
+        Response.Headers.CacheControl = "no-store";
+        return Ok(new NativeAuthResponse
+        {
+            AccessToken = session.AccessToken.Token,
+            AccessTokenExpiresAt = session.AccessToken.ExpiresAt,
+            RefreshToken = session.RefreshToken,
+            RefreshTokenExpiresAt = session.RefreshTokenExpiresAt,
+            SessionId = session.SessionId
+        });
+    }
+
+    private ClientSessionInfo CreateClientSessionInfo()
+    {
+        var userAgent = Request.Headers.UserAgent.ToString();
+        return new ClientSessionInfo
+        {
+            UserAgent = string.IsNullOrWhiteSpace(userAgent) ? "Unknown device" : userAgent[..Math.Min(userAgent.Length, 512)],
+            IpAddress = HttpContext.Connection.RemoteIpAddress?.ToString() ?? "Unknown"
+        };
+    }
+
+    private ObjectResult UnauthorizedProblem() => Problem(statusCode: StatusCodes.Status401Unauthorized, title: "Unauthenticated", detail: "Please sign in again.");
+}
